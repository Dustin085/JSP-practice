<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.example.jsppractice.mapper.BookMapper">

	<resultMap id="bookSummaryResultMap"
		type="com.example.jsppractice.dto.BookSummary">
		<id column="id" property="id" />
		<result column="title" property="title" />
		<result column="isbn" property="isbn" />
		<result column="published_year" property="publishedYear" />
		<result column="author_name" property="authorName" />
		<collection property="categories"
			ofType="com.example.jsppractice.model.Category">
			<id column="category_id" property="id" />
			<result column="category_name" property="name" />
		</collection>
	</resultMap>

	<sql id="bookSummarySelect">
		SELECT b.id, b.title, b.isbn, b.published_year, a.name AS
		author_name,
		c.id AS category_id, c.name AS category_name
	</sql>

	<sql id="bookSearchJoins">
		FROM books b
		LEFT JOIN authors a ON b.author_id = a.id
		LEFT JOIN books_categories bc ON bc.book_id = b.id
		LEFT JOIN categories c ON bc.category_id = c.id
	</sql>

	<sql id="bookSearchWhere">
		<where>
			<if test="keyWord != null and keyWord != ''">
				(b.title ILIKE CONCAT('%', #{keyWord}, '%')
				OR a.name ILIKE CONCAT('%', #{keyWord}, '%')
				OR c.name ILIKE CONCAT('%', #{keyWord}, '%'))
			</if>
		</where>
	</sql>

	<select id="findAll" resultMap="bookSummaryResultMap">
		<include refid="bookSummarySelect" />
		<include refid="bookSearchJoins" />
		ORDER BY b.id
	</select>

	<!-- 不分頁的完整搜尋結果,給 Excel 匯出用——匯出本來就該匯出全部符合條件的資料,不能只匯出單一頁 -->
	<select id="search" resultMap="bookSummaryResultMap">
		<include refid="bookSummarySelect" />
		<include refid="bookSearchJoins" />
		<include refid="bookSearchWhere" />
		ORDER BY b.id
	</select>

	<!--
		分頁不能直接對這個查詢下 LIMIT/OFFSET：books_categories/categories 的 LEFT JOIN
		會讓一本書因為有好幾個分類而展開成好幾列，LIMIT 算的會是「JOIN 出來的列數」，
		不是「幾本不同的書」。所以拆成三條查詢：先撈這一頁「有哪些書的 id」（不需要
		分類 JOIN 展開，用 DISTINCT 避免分類把列數灌水）、再用這些 id 撈完整資料
		（含分類），總筆數也是獨立查詢，才會正確反映搜尋條件篩選後的結果。
	-->
	<select id="findIdsBySearch" resultType="java.lang.Long">
		SELECT DISTINCT b.id
		<include refid="bookSearchJoins" />
		<include refid="bookSearchWhere" />
		ORDER BY b.id
		LIMIT #{pageReq.pageSize}
		OFFSET #{pageReq.offset}
	</select>

	<select id="countBySearch" resultType="long">
		SELECT COUNT(DISTINCT b.id)
		<include refid="bookSearchJoins" />
		<include refid="bookSearchWhere" />
	</select>

	<select id="findByIds" resultMap="bookSummaryResultMap">
		<include refid="bookSummarySelect" />
		<include refid="bookSearchJoins" />
		<where>
			b.id IN
			<foreach collection="ids" item="id" open="(" separator="," close=")">
				#{id}
			</foreach>
		</where>
		ORDER BY b.id
	</select>

	<select id="findById"
		resultType="com.example.jsppractice.model.Book">
		SELECT id, title, isbn, author_id, published_year
		FROM books
		WHERE id = #{id}
	</select>

	<!-- 對帳「重新連結」用：isbn 完全相符優先，否則退回書名模糊比對——這裡刻意選最簡單的比對方式，
		 沒有做相似度分數之類的複雜比對，讓使用者自己從候選清單挑，挑錯的風險比自動選中還低 -->
	<select id="findRelinkCandidates" resultType="com.example.jsppractice.model.Book">
		SELECT id, title, isbn, author_id, published_year
		FROM books
		WHERE (isbn IS NOT NULL AND isbn &lt;&gt; '' AND isbn = #{isbn})
		OR title ILIKE CONCAT('%', #{title}, '%')
		ORDER BY id
	</select>

	<insert id="insert" useGeneratedKeys="true" keyProperty="id">
		INSERT
		INTO books (title, isbn, author_id, published_year)
		VALUES (#{title},
		#{isbn}, #{authorId}, #{publishedYear})
	</insert>

	<update id="update">
		UPDATE books
		SET title = #{title}, isbn = #{isbn},
		author_id = #{authorId}, published_year = #{publishedYear}
		WHERE id =
		#{id}
	</update>

	<delete id="deleteById">
		DELETE FROM books WHERE id = #{id}
	</delete>

	<select id="findByAuthorId"
		resultType="com.example.jsppractice.model.Book">
		SELECT *
		FROM books b
		WHERE b.author_id = #{id}
	</select>

	<select id="findCategoriesById"
		resultType="com.example.jsppractice.model.Category">
		SELECT c.*
		FROM categories c
		JOIN books_categories bc ON
		bc.category_id = c.id
		WHERE bc.book_id = #{id}
	</select>

	<delete id="deleteCategoriesByBookId">
		DELETE
		FROM books_categories bc
		WHERE bc.book_id =
		#{id}
	</delete>

	<insert id="insertBookCategories">
		INSERT INTO books_categories (book_id, category_id)
		VALUES
		<foreach collection="categoryIds" item="categoryId"
			separator=",">
			(#{bookId}, #{categoryId})
		</foreach>
	</insert>

</mapper>
