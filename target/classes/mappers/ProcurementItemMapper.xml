<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper
	namespace="com.example.jsppractice.mapper.ProcurementItemMapper">
	<resultMap
		type="com.example.jsppractice.dto.ProcurementSummary"
		id="procurementSummaryResultMap">
		<id column="id" property="id" />
		<result column="status" property="status" />
		<result column="procured_by" property="procuredBy" />
		<result column="procured_at" property="procuredAt" />
		<result column="book_id" property="bookId" />
		<association property="bookRequestItem"
			javaType="com.example.jsppractice.model.BookRequestItem">
			<id property="id" column="book_request_item_id" />
			<result column="title" property="title" />
			<result column="isbn" property="isbn" />
			<result column="author_id" property="authorId" />
			<result column="published_year" property="publishedYear" />
			<result column="estimated_price" property="estimatedPrice" />
		</association>
	</resultMap>

	<select id="findById"
		resultType="com.example.jsppractice.model.ProcurementItem">
		SELECT * FROM procurement_items WHERE id = #{id}
	</select>

	<select id="findByIdForUpdate"
		resultType="com.example.jsppractice.model.ProcurementItem">
		SELECT *
		FROM procurement_items
		WHERE id = #{id}
		FOR
		UPDATE
	</select>

	<select id="findByStatus"
		resultType="com.example.jsppractice.model.ProcurementItem">
		SELECT * FROM procurement_items WHERE status = #{status}
	</select>

	<!-- status 可以是 null，代表不篩選狀態、撈全部採購項目 -->
	<select id="findSummary" resultMap="procurementSummaryResultMap">
		SELECT p.*,
		b.title,b.isbn,b.author_id,b.published_year,b.estimated_price
		FROM
		procurement_items p
		JOIN book_request_items b ON p.book_request_item_id
		= b.id
		<where>
			<if test="status != null">p.status = #{status}</if>
		</where>
		ORDER BY p.id DESC
	</select>

	<select id="findCompletedWithoutBook"
		resultType="com.example.jsppractice.model.ProcurementItem">
		SELECT pi.*
		FROM procurement_items pi
		LEFT JOIN books b ON
		pi.book_id = b.id
		WHERE pi.status = 'COMPLETED'
		AND b.id IS NULL
		AND NOT EXISTS (
			SELECT 1 FROM reconciliation_items ri
			WHERE ri.entity_type = 'PROCUREMENT_ITEM' AND ri.entity_id = pi.id AND ri.status = 'WRITTEN_OFF'
		)
	</select>

	<insert id="insert" useGeneratedKeys="true" keyProperty="id">
		INSERT
		INTO procurement_items (book_request_item_id, status)
		VALUES
		(#{bookRequestItemId}, #{status})
	</insert>

	<update id="update">
		UPDATE procurement_items
		SET status = #{status},
		procured_by = #{procuredBy}, procured_at = #{procuredAt}, book_id =
		#{bookId}
		WHERE id = #{id}
	</update>

</mapper>
