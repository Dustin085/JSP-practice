<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.example.jsppractice.mapper.BookRequestItemMapper">

	<select id="findById" resultType="com.example.jsppractice.model.BookRequestItem">
		SELECT * FROM book_request_items WHERE id = #{id}
	</select>

	<select id="findByBookRequestId" resultType="com.example.jsppractice.model.BookRequestItem">
		SELECT * FROM book_request_items WHERE book_request_id = #{bookRequestId}
	</select>

	<insert id="insert" useGeneratedKeys="true" keyProperty="id">
		INSERT INTO book_request_items
			(book_request_id, title, isbn, author_id, published_year, estimated_price)
		VALUES
			(#{bookRequestId}, #{title}, #{isbn}, #{authorId}, #{publishedYear}, #{estimatedPrice})
	</insert>

</mapper>
